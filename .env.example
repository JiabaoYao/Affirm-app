# Copy to .env and change the secrets. Never commit .env.
# The DB user/password here must match DATABASE_URL.
POSTGRES_USER=affirm
POSTGRES_PASSWORD=affirm
POSTGRES_DB=affirm
DATABASE_URL=postgresql+psycopg://affirm:affirm@db:5432/affirm

# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-bytes
JWT_EXPIRE_MINUTES=60

# Origins allowed to call the API from a browser (the future React app).
CORS_ORIGINS=["http://localhost:5173"]

# Host port for the API (default 8000). Windows sometimes reserves 8000; use e.g. 8080 there.
# API_PORT=8080
